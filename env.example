# Moodist Flask Server — environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env.

# Flask configuration
FLASK_APP=app.py
FLASK_CONFIG=development          # development | testing | production
FLASK_DEBUG=1
PORT=20001
HOST=127.0.0.1

# Security — generate strong random values for each environment
SECRET_KEY=change-me
SECURITY_PASSWORD_SALT=change-me
SECURITY_PASSWORD_PEPPER=change-me

# Development settings
LOG_LEVEL=INFO
SSL_ENABLED=true

# CORS settings (comma-separated origins; permissive for development)
CORS_ALLOW_ORIGINS=*

# SSL/TLS — paths to your certificate and private key
SSL_CERT=certs/cert.pem
SSL_KEY=certs/key.pem

# CouchDB
COUCHDB_HOST=127.0.0.1
COUCHDB_PORT=5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me
COUCHDB_DB=moodist

# Email (verification and password-reset messages)
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_PORT=465
EMAIL_USE_SSL=true

# Public domain (used in verification links)
DOMAIN_NAME=localhost
